<?xml version="1.0" encoding="utf-8"?>
<!-- Android's automatic Google backup and phone-to-phone transfer (Android 12+). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="activities/" />
        <include domain="file" path="extras/" />
        <include domain="sharedpref" path="meridian.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="activities/" />
        <include domain="file" path="extras/" />
        <include domain="sharedpref" path="meridian.xml" />
    </device-transfer>
</data-extraction-rules>
