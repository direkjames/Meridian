<?xml version="1.0" encoding="utf-8"?>
<!-- Meridian mark: a globe outline crossed by a bold yellow meridian, with a location dot. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Globe -->
    <path
        android:pathData="M54,29 A25,25 0 1,1 54,79 A25,25 0 1,1 54,29 Z"
        android:strokeColor="#F4F2EA"
        android:strokeAlpha="0.38"
        android:strokeWidth="2.5"
        android:fillColor="#00000000" />
    <!-- Equator -->
    <path
        android:pathData="M29,54 L79,54"
        android:strokeColor="#F4F2EA"
        android:strokeAlpha="0.22"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- Meridian -->
    <path
        android:pathData="M54,29 A11,25 0 1,1 54,79 A11,25 0 1,1 54,29 Z"
        android:strokeColor="#FFE566"
        android:strokeWidth="5"
        android:fillColor="#00000000" />
    <!-- You are here -->
    <path
        android:pathData="M65,45 A4.5,4.5 0 1,1 65,54 A4.5,4.5 0 1,1 65,45 Z"
        android:fillColor="#FFE566" />
</vector>
